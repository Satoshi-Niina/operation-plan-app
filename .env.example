# ダッシュボード（00_DashboodUI）連携SSO検証用
SHARED_SSO_SECRET=
DASHBOARD_JWT_ISSUER=dashboard-auth
DASHBOARD_JWT_AUDIENCE=dashboard-apps

# 本アプリ用セッション署名鍵
APP_SESSION_SECRET=

# 統合リバースプロキシゲートウェイ内部HMAC署名シークレット
INTERNAL_GATEWAY_SECRET=
# ローカル開発時の直接アクセス許可フラグ（本番では設定しない）
ALLOW_DIRECT_INTERNAL=false

# ダッシュボードオリジンURL（postMessageハンドシェイク用）
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000

# データベース接続設定（マルチテナント）
# 基準DB（common_db）への接続URL。各テナント接続時は [tenant]_db へ動的に切り替わります。
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/common_db
DATABASE_SSL=false

# （任意）各テナントDBへの個別直接接続URL
# TENANT_DB_DAITETSU_URL=postgresql://user:password@127.0.0.1:5432/daitetsu_db
# TENANT_DB_KOSEI_URL=postgresql://user:password@127.0.0.1:5432/kosei_db
# TENANT_DB_KINTETSU_URL=postgresql://user:password@127.0.0.1:5432/kintetsu_db
